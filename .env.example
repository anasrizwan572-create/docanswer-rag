# DocAnswer Environment Configuration
# Never put real API keys in this file.

# LLM: Gemini primary
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# LLM: Claude secondary fallback
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Embeddings
# Supported providers depend on api/embeddings.py.
EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
VOYAGE_API_KEY=
VOYAGE_EMBEDDING_MODEL=voyage-3-lite

# Retrieval and request limits
MAX_QUESTION_LENGTH=500
RATE_LIMIT_PER_MINUTE=30
