# ==============================================================================
# DocAnswer Environment Variables Template
# ==============================================================================

# Anthropic Claude API Configuration
# Required in production. Uses Claude 3.5 Sonnet by default.
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Hosted Embeddings Provider: "openai", "voyage", or "deterministic"
# Note: Local PyTorch/sentence-transformers are disallowed on Vercel serverless.
EMBEDDING_PROVIDER=openai

# OpenAI Hosted Embeddings (text-embedding-3-small)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Voyage AI Hosted Embeddings (alternative hosted embeddings)
VOYAGE_API_KEY=
VOYAGE_EMBEDDING_MODEL=voyage-3-lite

# Security & Rate Limiting
MAX_QUESTION_LENGTH=500
RATE_LIMIT_PER_MINUTE=30

